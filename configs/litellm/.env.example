# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit real keys. `.env.example` IS committed,
# and must never contain a real key.

# ── LiteLLM's own master key ─────────────────────────────────────────────────
# Clients send this as `Authorization: Bearer <key>`. For a laptop it can be
# anything; make it long enough that you will not type it wrong.
# Generate one:  openssl rand -hex 24
LITELLM_MASTER_KEY=sk-workshop-change-me
LITELLM_API_KEY=sk-workshop-change-me

# ── Cloud fallback (OPTIONAL but strongly recommended) ───────────────────────
# Exercise 5 demonstrates the gateway failing over to the cloud when your local
# model is down. Without one of these keys the `resilient` route has nowhere to
# fall back to, and that exercise cannot be completed.
#
# OpenRouter is the easiest: one key reaches hundreds of models, and it has free
# tiers. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Where your local stack lives ─────────────────────────────────────────────
# `host.docker.internal` reaches the host from inside the container. This works
# because docker-compose.yml declares it under extra_hosts. On Linux without that
# declaration, this name does not resolve and every request fails with a
# connection error — that is the single most common LiteLLM problem in this
# workshop.
LOCAL_API_BASE=http://host.docker.internal:8090/v1

# If you skipped llama-swap and are running llama.cpp directly, point at it
# instead:
# LOCAL_API_BASE=http://host.docker.internal:8080/v1

# llama-swap and llama.cpp do not authenticate by default on localhost, so
# LiteLLM still has to SEND something. "dummy" is correct — do not go looking
# for a real key here.
LOCAL_API_KEY=dummy
